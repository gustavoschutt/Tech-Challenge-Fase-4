# Copie este arquivo para .env e ajuste. O .env NÃO vai para o Git.

# Pasta com os CSVs do dataset Olist (Kaggle) e pasta dos artefatos gerados
DATA_DIR=data/raw
# ARTIFACTS_DIR=artifacts
# SEED=42

# --- Representação vetorial -------------------------------------------------
# sentence-transformers (padrão) | lsa (TF-IDF+SVD, 100% offline, baseline)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Re-ranking (deixe vazio para desligar) -----------------------------------
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- LLM ------------------------------------------------------------------------
# hf | ollama | openai | gemini | anthropic | openai_compatible | extractive
LLM_PROVIDER=hf
LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# Exemplos (confira no provedor o nome atual do modelo; nomes mudam com o tempo):
#   LLM_PROVIDER=ollama     LLM_MODEL=qwen2.5:3b
#   LLM_PROVIDER=openai     LLM_MODEL=gpt-4o-mini          (+ OPENAI_API_KEY)
#   LLM_PROVIDER=gemini     LLM_MODEL=gemini-3.8-flash     (+ GEMINI_API_KEY)
#   LLM_PROVIDER=anthropic  LLM_MODEL=claude-opus-5-5      (+ ANTHROPIC_API_KEY)
#   LLM_PROVIDER=openai_compatible  LLM_MODEL=<modelo>  (+ LLM_BASE_URL e LLM_API_KEY)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=
LLM_TEMPERATURE=0.0
# Só para LLM_PROVIDER=anthropic (modelos com raciocínio sempre ligado, ex. claude-opus-5-5):
# a temperatura não é enviada; o raciocínio conta dentro de max_tokens.
ANTHROPIC_MAX_TOKENS=8000
ANTHROPIC_EFFORT=low
# Modelos antigos da Anthropic que aceitam temperatura: true
# ANTHROPIC_SEND_TEMPERATURE=false
# Só para provedores via API compatível com OpenAI. No Gemini os padrões já são:
# temperatura não enviada (o Google recomenda o padrão 1.0), max_tokens 8000 e raciocínio "low".
# LLM_SEND_TEMPERATURE=false
# LLM_API_MAX_TOKENS=8000
# LLM_REASONING_EFFORT=low
# Novas tentativas automáticas em erro 429/5xx (APIs Gemini, OpenAI e Anthropic):
# LLM_MAX_RETRIES=6
# Só para LLM_PROVIDER=hf: auto | float32 | bfloat16 (bfloat16 = metade da RAM na CPU)
LLM_DTYPE=auto
LLM_MAX_NEW_TOKENS=450

# --- Recuperação e gate -----------------------------------------------------------
# Os limiares de escopo e de relevância são calibrados e lidos de
# artifacts/limiares__<modelo>.json (scripts/04_calibrar_limiares.py). Esse arquivo
# também guarda o MIN_EVIDENCES usado na calibração e tem prioridade sobre o valor abaixo.
TOP_K_CONTEXT=8
MIN_EVIDENCES=3
LEXICAL_GATE=true
# Camada analítica: abaixo desta base (avaliações com comentário) não calcula porcentagens.
MIN_BASE_ANALITICO=30
